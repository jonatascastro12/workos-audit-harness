{
  "name": "@workos-inc/codex-audit-plugin",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Codex plugin: emit lifecycle events and query WorkOS audit logs.",
  "scripts": {
