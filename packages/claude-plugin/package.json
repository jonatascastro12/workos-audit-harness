{
  "name": "@workos-inc/claude-audit-plugin",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Claude Code plugin: emit lifecycle events and query WorkOS audit logs.",
  "scripts": {
    "configure": "node dist/scripts/configure.mjs",
    "start": "npm install --no-audit --no-fund --silent && node dist/server/index.mjs",
    "create:schemas": "node dist/scripts/create-claude-schemas.mjs",
    "remove:schemas": "node dist/scripts/remove-claude-schemas.mjs",
    "bundle": "node ../../scripts/bundle-plugins.mjs claude-plugin"
  },
  "dependencies": {
    "@napi-rs/keyring": "^1.3.0"
  }
}
